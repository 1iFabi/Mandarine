<Window x:Class="Mandarine.PdfPagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mandarine"
        Background="#F3F3F3" WindowStartupLocation="CenterScreen" MinWidth="820" MinHeight="560"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1C1C1E"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EditorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A page: click to choose it (Rotate). Chosen pages are ringed in the accent. -->
            <Style x:Key="PageTile" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="4,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Padding="6,6,6,4" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Background" Value="#E8E8EB" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#1C1C1E" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Ring" Property="Background" Value="#FFE7DA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The gap after a page (Split): a line and scissors on hover, solid in the accent once it is a cut. -->
            <Style x:Key="Cut" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Margin" Value="0,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <Rectangle x:Name="Line" Width="2" Fill="#B4B4BA" Opacity="0" />
                                <Border x:Name="Badge" Width="24" Height="24" CornerRadius="12" Background="White" BorderBrush="#C8C8CC" BorderThickness="1"
                                        VerticalAlignment="Center" Opacity="0">
                                    <TextBlock x:Name="Glyph" Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#5E5E63"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Opacity" Value="0.7" />
                                    <Setter TargetName="Badge" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Badge" Property="Opacity" Value="1" />
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="#1C1C1E" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Line" Property="Fill" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Line" Property="Opacity" Value="1" />
                                    <Setter TargetName="Badge" Property="Opacity" Value="1" />
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Buttons on the reader's dark bar. -->
            <Style x:Key="Dark" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Body" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="#48484A" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Body" Property="Background" Value="#5A5A5E" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Body" Property="BorderBrush" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock x:Name="Hint" DockPanel.Dock="Top" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="28,16,28,0" />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,10,8,0" Focusable="False">
                <WrapPanel x:Name="Pages" HorizontalAlignment="Center" Margin="0,0,0,16" />
            </ScrollViewer>
        </DockPanel>
        <local:EditorPane x:Name="Pane" Grid.Column="1" />
        <!-- The reader: one page large and sharp (double-click a page); zoom, scroll and drag to read. -->
        <Grid x:Name="Viewer" Grid.ColumnSpan="2" Background="#1C1C1E" Visibility="Collapsed">
            <ScrollViewer x:Name="LargeScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,64" Focusable="False">
                <Image x:Name="Large" Stretch="Fill" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
            <Button x:Name="CloseViewer" Style="{StaticResource Dark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                    ToolTip="Volver (Esc)" AutomationProperties.Name="Volver a las páginas">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Background="#2C2C2E" CornerRadius="10" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevPage" Style="{StaticResource Dark}" ToolTip="Página anterior (←)" AutomationProperties.Name="Página anterior">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="PageLabel" Foreground="White" VerticalAlignment="Center" Margin="10,0" MinWidth="96" TextAlignment="Center" />
                    <Button x:Name="NextPage" Style="{StaticResource Dark}" ToolTip="Página siguiente (→)" AutomationProperties.Name="Página siguiente">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Rectangle Width="1" Fill="#48484A" Margin="8,6" />
                    <Button x:Name="ZoomOut" Style="{StaticResource Dark}" ToolTip="Alejar (−)" AutomationProperties.Name="Alejar">
                        <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="ZoomLabel" Foreground="White" VerticalAlignment="Center" Margin="6,0" MinWidth="44" TextAlignment="Center" />
                    <Button x:Name="ZoomIn" Style="{StaticResource Dark}" ToolTip="Acercar (+)" AutomationProperties.Name="Acercar">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                    <Button x:Name="FitWidth" Style="{StaticResource Dark}" Content="Ancho" ToolTip="Ajustar al ancho (W)" />
                    <Button x:Name="FitPage" Style="{StaticResource Dark}" Content="Página" ToolTip="Página entera (0)" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
