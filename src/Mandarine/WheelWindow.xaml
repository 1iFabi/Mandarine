<Window x:Class="Mandarine.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="210" Height="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True">
    <!-- Near-invisible fill: the whole wheel receives the drag, so pointing in a direction is enough. -->
    <Canvas x:Name="Root" Background="#01000000" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Canvas.RenderTransform>
        <Canvas.Effect>
            <BlurEffect x:Name="RootBlur" Radius="0" KernelType="Gaussian" />
        </Canvas.Effect>
        <!-- One soft shadow under the whole ring, so it floats as a single object. -->
        <Canvas x:Name="Petals">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black" />
            </Canvas.Effect>
        </Canvas>
        <Canvas x:Name="CenterDrop">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.2" Color="Black" />
            </Canvas.Effect>
        </Canvas>
    </Canvas>
</Window>
